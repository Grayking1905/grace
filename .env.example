# Local development uses an on-disk SQL database; no service is required.
DB_DRIVER=sqlite
SQLITE_PATH=./data/grace.sqlite
# Set DB_DRIVER=mysql and supply a dedicated, empty MySQL 8+ database.
DATABASE_URL=mysql://grace:change-me@127.0.0.1:3306/grace
PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
# Generate a long random value before using Grace beyond local development.
JWT_SECRET=
# Demo login and sample workspace are local development conveniences.
DEMO_MODE=true
SEED_DEMO=true
NODE_ENV=development
# SMTP secrets stay on the server. SMTP_SECURE=true normally uses port 465;
# port 587 uses STARTTLS. Delivery metadata never contains reset/verification links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Grace <no-reply@example.com>
# Always enforced in production. Enable locally after configuring SMTP.
AUTH_REQUIRE_VERIFIED=false
# Used only by encrypted database backup/restore commands; keep it separate from JWT_SECRET.
BACKUP_KEY=
